class Payment {

    void makePayment(double amount) {
        System.out.println("Payment Amount: " + amount);
    }

    void makePayment(double amount, String name) {
        System.out.println("Amount: " + amount);
        System.out.println("Name: " + name);
    }

    void makePayment(double amount, String name, String type) {
        System.out.println("Amount: " + amount);
        System.out.println("Name: " + name);
        System.out.println("Type: " + type);
    }
}

// One subclass
class UPIPayment extends Payment {

    void makePayment(double amount) {
        System.out.println("UPI Payment: " + amount);
    }

    void makePayment(double amount, String name) {
        System.out.println("UPI Amount: " + amount);
        System.out.println("Name: " + name);
    }

    void makePayment(double amount, String name, String type) {
        System.out.println("UPI Amount: " + amount);
        System.out.println("Name: " + name);
        System.out.println("Type: " + type);
    }
}

public class Main {
    public static void main(String[] args) {

        UPIPayment p = new UPIPayment();

        // Compile-time polymorphism
        System.out.println("--- Compile-Time Polymorphism ---");

        p.makePayment(500);
        p.makePayment(1000, "Shreeja");
        p.makePayment(1500, "Shreeja", "UPI");

        // Runtime polymorphism
        System.out.println("\n--- Runtime Polymorphism ---");

        Payment obj = new UPIPayment();

        obj.makePayment(2000);
        obj.makePayment(2500, "Shreeja");
        obj.makePayment(3000, "Shreeja", "UPI");
    }
}
